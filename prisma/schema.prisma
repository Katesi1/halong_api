generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  name             String
  phone            String?   @unique
  email            String    @unique
  password         String? // null nếu user chỉ login Google
  role             Int       @default(2) // 0=ADMIN, 1=OWNER, 2=SALE, 3=CUSTOMER
  /// SALE scope: "owner" (thuộc 1 OWNER, mặc định) | "system" (admin-grade SALE do ADMIN tạo).
  /// Field áp dụng riêng cho role=SALE; các role khác giữ "owner" vô nghĩa nhưng giữ default cho data legacy.
  scope            String    @default("owner")
  ownerId          String? // SALE → trỏ về User có role OWNER (chủ của mình). System SALE có ownerId=null
  gender           Int? // 0=MALE, 1=FEMALE, 2=OTHER
  dateOfBirth      DateTime?
  isActive         Boolean   @default(true)
  refreshToken     String?   // DEPRECATED — legacy 1-session-total. Giữ để tương thích dữ liệu cũ, có thể drop sau.
  refreshTokenMobile String? // Session app native (Android/iOS). Login mobile mới → đá device cũ.
  refreshTokenWeb    String? // Session web browser. Login web mới → đá browser cũ.
  sessionIdMobile    String? // Session id phiên mobile hiện tại — nhúng vào JWT (sid). Login mới đổi id → access token thiết bị cũ bị đá NGAY.
  sessionIdWeb       String? // Session id phiên web hiện tại — nhúng vào JWT (sid).
  googleSub        String?   @unique // Google's sub claim — stable user ID
  appleSub         String?   @unique // Apple's sub claim — stable user ID
  emailVerified    Boolean   @default(false)
  avatar           String? // URL ảnh đại diện (từ Google picture hoặc upload)
  registerDeviceId String? // Device ID lúc tạo account — chống spam register
  registerIp       String? // IP lúc tạo account — chống spam register

  // Thông tin nhận tiền của OWNER — khách chuyển khoản cọc sau khi owner confirm booking.
  // BE tự sinh VietQR động (buildVietQrPayload) từ bankBin + bankAccountNumber; không lưu ảnh QR.
  bankBin           String? // NAPAS BIN 6 số, vd "970436" (Vietcombank) — GIÁ TRỊ ĐÃ DUYỆT (live, dùng sinh VietQR)
  bankName          String? // Tên hiển thị ngân hàng, vd "Vietcombank"
  bankAccountNumber String? // Số tài khoản nhận tiền
  bankAccountName   String? // Tên chủ tài khoản (in trên QR/hiển thị)

  // Duyệt thông tin nhận tiền — OWNER submit tạo/sửa bank qua PUT /users/me/bank → ADMIN duyệt
  // mới copy pending* → bank* live. Chỉ giá trị đã duyệt (bank*) mới được dùng sinh VietQR.
  bankStatus               String    @default("none") // none | pending | approved | rejected
  bankSubmittedAt          DateTime? // lúc OWNER gửi yêu cầu gần nhất
  bankReviewedAt           DateTime? // lúc ADMIN duyệt/từ chối
  bankReviewedBy           String?   // adminId đã xử lý
  bankRejectReason         String?   // lý do từ chối (chỉ có khi bankStatus=rejected)
  pendingBankBin           String?   // giá trị chờ duyệt
  pendingBankName          String?
  pendingBankAccountNumber String?
  pendingBankAccountName   String?

  // Admin moderation
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // KYC & Subscription
  kycBypass                 Boolean   @default(false) // ADMIN grant: skip KYC to manage properties
  kycStatus                 String    @default("none") // none | pending | approved | rejected
  kycSubmissionId           String?
  subscriptionStatus        String    @default("none") // none | trial | active | past_due | cancelled | expired | frozen
  subscriptionPlanId        String?
  subscriptionCycle         String? // monthly | yearly
  subscriptionProvider      String? // apple_iap | vnpay | manual_bank | manual | null
  subscriptionPriceOverride Int? // VND custom price per cycle set by admin (null = use plan default)
  subscriptionFrozenAt      DateTime?
  subscriptionFrozenReason  String?
  trialEndsAt               DateTime?
  nextChargeAt              DateTime?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  // Deferred downgrade — apply pending plan when current period ends
  pendingPlanId             String?
  pendingCycle              String?
  pendingEffectiveAt        DateTime?

  owner               User?            @relation("OwnerStaff", fields: [ownerId], references: [id])
  staffMembers        User[]           @relation("OwnerStaff")
  properties          Property[]
  notifications       Notification[]
  saleBookings        Booking[]        @relation("SaleBookings")
  customerBookings    Booking[]        @relation("CustomerBookings")
  kycSubmissions      KycSubmission[]
  approvedSubmissions KycSubmission[]  @relation("ApprovedBy")
  reviews             PropertyReview[]

  permissions     UserPermission[]
  subscriptions   Subscription[]
  paymentSessions PaymentSession[]
  sentInvites     StaffInvite[]    @relation("InviteOwner")
  acceptedInvite  StaffInvite?     @relation("InviteAcceptedUser")
  devices         UserDevice[]

  supportTickets         SupportTicket[]
  supportTicketMessages  SupportTicketMessage[]
  feedbacks              Feedback[]
  dataExportRequests     DataExportRequest[]
  consent                UserConsent?
  notificationPreference NotificationPreference?
  deletionRequests       AccountDeletionRequest[]
  favoriteProperties     UserFavoriteProperty[]

  // Account deletion grace (NĐ 13)
  deletionScheduledAt DateTime? // != null → user đang trong grace 30 ngày, login → auto-cancel

  @@index([bankStatus])
  @@map("users")
}

/// NĐ 13 — user self-delete có grace 30 ngày
/// User gọi DELETE /users/me → tạo row pending + set User.deletionScheduledAt
/// Cron mỗi giờ: pending + scheduledAt <= now → thực thi soft-delete + rename + clear sessions
/// User login lại trong grace → status=cancelled, clear deletionScheduledAt
model AccountDeletionRequest {
  id                String    @id @default(uuid())
  userId            String
  status            String    @default("pending") // pending | completed | cancelled
  reason            String?
  requestedAt       DateTime  @default(now())
  scheduledDeleteAt DateTime  // requestedAt + 30 ngày
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?   // "user_login" | "user_cancel" | "admin_cancel"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledDeleteAt])
  @@map("account_deletion_requests")
}

model UserDevice {
  id           String   @id @default(uuid())
  userId       String
  fcmToken     String   @unique // FCM registration token
  platform     String // ios | android
  deviceModel  String? // iPhone 13, Galaxy S21, ...
  osVersion    String? // 17.4
  appVersion   String? // 1.0.2
  locale       String? // vi | en
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

model StaffInvite {
  id             String    @id @default(uuid())
  ownerId        String // OWNER tạo invite, hoặc ADMIN id nếu là system invite (ngữ nghĩa "inviter")
  email          String
  token          String    @unique // 64 hex chars (32 bytes random)
  shortCode      String    @unique // "HL-XXXXXX" — dùng cho UX nhập tay
  status         String    @default("pending") // pending | accepted | expired | cancelled
  /// "owner" (mặc định, SALE thuộc OWNER) | "system" (admin tạo SALE hệ thống, accepted user → role=SALE scope=system ownerId=null)
  scope          String    @default("owner")
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User  @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  acceptedUser User? @relation("InviteAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([ownerId, status])
  @@index([email, status])
  @@map("staff_invites")
}

model UserPermission {
  id        String  @id @default(uuid())
  userId    String
  module    String // properties | bookings | calendar | reviews
  canCreate Boolean @default(false)
  canRead   Boolean @default(true)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@map("user_permissions")
}

model Property {
  id                       String    @id @default(uuid())
  ownerId                  String
  name                     String
  slug                     String    @unique
  type                     Int       @default(1) // 0=VILLA, 1=HOMESTAY, 2=HOTEL
  code                     String    @unique
  isActive                 Boolean   @default(true)
  moderationStatus         String    @default("approved") // pending | approved | rejected
  moderationRejectedReason String?
  moderationReviewedAt     DateTime?
  moderationReviewedBy     String?

  // View
  view String? // "sea", "city", "mountain", "garden", "pool", null

  // Location
  address   String?
  city      String? // Display-only (vd "Hạ Long"). Không dùng để filter list public.
  district  String? // Display-only (vd "Bãi Cháy").
  latitude  Float?
  longitude Float?
  mapLink   String?

  // Specs
  bedrooms       Int  @default(1)
  bathrooms      Int  @default(1)
  standardGuests   Int  @default(2) // số người lớn tiêu chuẩn (đã bao trong giá)
  standardChildren Int  @default(0) // sức chứa trẻ em tiêu chuẩn (đã bao trong giá)
  maxGuests        Int  @default(2) // tối đa cả căn (không chia người lớn/trẻ em)
  floorArea      Int? // m² — optional, FE hiển thị null nếu owner chưa điền

  // Aggregated review stats (denormalized — updated by reviews.service)
  ratingAvg   Float @default(0)
  reviewCount Int   @default(0)

  // Admin curated "hot" badge — bật bằng PATCH /properties/:id/hot (ADMIN only).
  isHot Boolean @default(false)

  // Pricing
  weekdayPrice   Float?
  weekendPrice   Float?
  holidayPrice   Float?
  adultSurcharge Float?
  childSurcharge Float?

  // Content
  amenities          String[] @default([])
  cancellationPolicy Int      @default(0) // 0=FLEXIBLE, 1=MODERATE, 2=STRICT
  rules              String?
  services           String[] @default([])
  description        String?

  // Check in/out
  checkInTime  String? @default("14:00")
  checkOutTime String? @default("12:00")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        PropertyImage[]
  bookings      Booking[]
  calendarLocks CalendarLock[]
  reviews       PropertyReview[]
  favoritedBy   UserFavoriteProperty[]

  @@index([isActive, deletedAt])
  @@index([type])
  @@index([isHot])
  @@index([ownerId])
  @@index([amenities], type: Gin)
  @@map("properties")
}

// Per-user favorites (wishlist / heart icon trên FE web khách hàng).
// Composite PK [userId, propertyId] → idempotent: POST 2 lần không tạo row trùng.
model UserFavoriteProperty {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("user_favorite_properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  imageUrl   String
  publicId   String
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Booking {
  id            String    @id @default(uuid())
  propertyId    String
  saleId        String?
  customerId    String?
  customerName  String?
  customerPhone String?
  customerEmail String? // email liên hệ khách (luồng customer-hold web)
  adults        Int?    // số người lớn (tách từ guestCount cho luồng khách)
  children      Int?    // số trẻ em 6–11 tuổi
  checkinDate   DateTime
  checkoutDate  DateTime
  status        Int       @default(0) // 0=HOLD, 1=CONFIRMED, 2=CANCELLED, 3=COMPLETED, 4=NO_SHOW
  holdExpireAt  DateTime?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByRole    Int?     // ROLE enum; null = system/cron
  cancelledReason    String?  // optional, pass-through cho email; không enforce
  noShowMarkedAt     DateTime?
  completedAt        DateTime? // set khi cron auto-complete sau 12h trưa ngày trả phòng, hoặc owner check-in
  checkedInAt        DateTime? // owner xác nhận khách đã check-in (PATCH /bookings/:id/checkin)
  depositProofUrl    String?   // ảnh bill chuyển khoản cọc do khách gửi (POST /bookings/:id/deposit-proof)
  reviewInviteSentAt DateTime? // set khi cron gửi email mời đánh giá (12h trưa ngày checkout) — chống gửi trùng
  depositAmount Int? // VND — luôn dùng Int, tránh sai số float64
  totalAmount   Int? // VND — tổng giá trị booking (lưu lại khi tạo để tránh re-compute)
  paidAmount    Int? // VND — số tiền thực thu (cập nhật qua mark-paid)
  paidAt        DateTime?
  guestCount    Int       @default(2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property Property        @relation(fields: [propertyId], references: [id])
  sale     User?           @relation("SaleBookings", fields: [saleId], references: [id])
  customer User?           @relation("CustomerBookings", fields: [customerId], references: [id])
  review   PropertyReview?

  @@index([propertyId, status])
  @@index([checkinDate, checkoutDate])
  @@index([saleId])
  @@index([customerId])
  @@map("bookings")
}

model CalendarLock {
  id         String   @id @default(uuid())
  propertyId String
  date       DateTime
  status     Int      @default(0) // 0=LOCKED, 1=BOOKED
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, date])
  @@map("calendar_locks")
}

model AppVersion {
  id                  String   @id @default(uuid())
  platform            String   @unique // ios | android
  latestVersion       String // e.g. "1.2.0"
  minSupportedVersion String // e.g. "1.0.0"
  releaseNotes        String?
  storeUrl            String // App Store / Play Store URL
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("app_versions")
}

model PartnerKey {
  id          String   @id @default(uuid())
  partnerName String
  apiKey      String   @unique
  isActive    Boolean  @default(true)
  rateLimit   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partner_keys")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  subtitle   String?
  type       Int      @default(2) // 0=BOOKING, 1=PAYMENT, 2=SYSTEM
  isRead     Boolean  @default(false)
  targetId   String?
  targetType String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model PropertyReview {
  id         String @id @default(uuid())
  propertyId String
  bookingId  String @unique
  customerId String

  // 6 score (1-5)
  cleanliness Int
  location    Int
  amenities   Int
  service     Int
  value       Int
  accuracy    Int

  // Avg pre-computed = (c+l+a+s+v+ac) / 6.0
  avgRating Float

  comment String?
  photos  Json? // ["url1", "url2", ...]

  // Owner reply
  ownerReply   String?
  ownerReplyAt DateTime?

  // Admin moderation
  isHidden     Boolean @default(false)
  hiddenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer User     @relation(fields: [customerId], references: [id])

  @@index([propertyId])
  @@index([customerId])
  @@map("property_reviews")
}

// ─── KYC ──────────────────────────────────────────────────────────────────────

model KycSubmission {
  id             String    @id @default(uuid())
  userId         String
  status         String    @default("draft") // draft | kyc_submitted | payment_pending | awaiting_approval | approved | rejected | refunded
  rejectReason   String?
  rejectedItems  String[]  @default([]) // ["cccdFront","cccdBack","selfie"]
  approvedAt     DateTime?
  approvedById   String?
  trialEndsAt    DateTime?
  chargeStartsAt DateTime?
  expectedRooms  Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  uploads    KycUpload[]
  payments   PaymentSession[]

  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

model KycUpload {
  id                String   @id @default(uuid())
  submissionId      String
  type              String // cccd_front | cccd_back | selfie
  imageUrl          String
  imageUrlThumb     String?
  publicId          String?
  ocrResult         Json?
  ocrConfidence     Float?
  faceMatchScore    Float?
  livenessScore     Float?
  provider          String? // fpt_ai | vnpt_ekyc | manual
  providerRequestId String?
  uploadedAt        DateTime @default(now())

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, type])
  @@index([submissionId])
  @@map("kyc_uploads")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingPlan {
  id                String   @id // rooms_1 | rooms_5 | rooms_10 | rooms_20 | rooms_50 | enterprise
  name              String
  pricePerRoom      Int // VND/month (deprecated, dùng minCharge làm monthlyPrice)
  minCharge         Int // VND/month — đây là giá Monthly hiển thị
  yearlyPrice       Int? // VND/year — explicit, khớp Apple StoreKit
  maxRooms          Int? // null hoặc -1 = unlimited
  yearlyDiscountPct Float    @default(20)
  vatPct            Float    @default(10)
  features          String[] @default([])
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)

  payments      PaymentSession[]
  subscriptions Subscription[]

  @@map("billing_plans")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id           String    @id @default(uuid())
  userId       String
  planId       String
  cycle        String // monthly | yearly
  rooms        Int       @default(1)
  status       String    @default("trial") // trial | active | past_due | cancelled | frozen
  startsAt     DateTime  @default(now())
  endsAt       DateTime
  cancelledAt  DateTime?
  // Admin-side fields for manual / overridden billing
  customPrice  Int? // VND snapshot of price for THIS period (null = computed from plan)
  paidAmount   Int? // VND actually received (manual mark-paid records this)
  provider     String? // vnpay | apple_iap | manual_bank | manual
  note         String? // admin note for manual ops
  frozenAt     DateTime?
  frozenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan BillingPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status, endsAt])
  @@map("subscriptions")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model PaymentSession {
  id              String    @id @default(uuid())
  userId          String
  submissionId    String? // null for renew/upgrade payments
  kind            String    @default("subscription") // subscription | renew | upgrade | refund
  planId          String
  planLabel       String? // denormalized for history display
  cycle           String // monthly | yearly
  rooms           Int
  totalAmount     Int // VND, includes VAT
  method          String // vnpay_qr | bank_transfer | card
  status          String    @default("pending") // pending | paid | failed | expired | refunded
  qrCode          String? // EMV payload string
  bankInfo        Json?
  redirectUrl     String?
  payUrl          String? // VNPay gateway URL
  provider        String? // vnpay | momo | manual_bank | casso | sepay
  providerTxnId   String?
  providerPayload Json?
  referenceCode   String? // bank tid / manual reference
  invoiceNumber   String?   @unique // INV-YYYY-NNNN
  settledAt       DateTime? // alias for paidAt for clearer history field
  paidAt          DateTime?
  refundedAt      DateTime?
  refundedAmount  Int?
  refundOfId      String? // links refund row → original payment row
  breakdown       Json? // { listPrice, creditApplied, vat, remainingDays, totalDays, periodExtension }
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission KycSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  plan       BillingPlan    @relation(fields: [planId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([submissionId])
  @@index([status, expiresAt])
  @@map("payment_sessions")
}

// ─── Platform receiving bank (STK nhận tiền MUA GÓI / subscription) ───────────
// Singleton (id luôn = 'default'). ADMIN sửa qua GET/PUT /admin/payments/receiving-bank.
// Chưa có row → PaymentService fallback về biến môi trường BANK_* (hành vi cũ).
// Dùng để sinh VietQR + bankInfo cho PaymentSession khi OWNER mua/gia hạn gói.
model PaymentBankAccount {
  id                String   @id // singleton: 'default'
  bankBin           String // NAPAS BIN 6 số, vd 970416 (ACB)
  bankName          String? // tên hiển thị ngân hàng (optional)
  bankAccountNumber String // số tài khoản nhận tiền
  bankAccountName   String // tên chủ tài khoản (in trên QR)
  updatedById       String? // admin id sửa gần nhất
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payment_bank_account")
}

// ─── Uploads (generic file upload tracking) ──────────────────────────────────

model UploadRecord {
  id           String @id @default(uuid())
  userId       String // ai upload
  url          String // CDN URL (https://res.cloudinary.com/.../...)
  publicId     String // Cloudinary public_id để destroy
  resourceType String // 'image' | 'raw' (PDF) | 'video' (defer v2)
  mimeType     String // image/jpeg, application/pdf, ...
  originalName String // tên gốc khách upload (sanitized)
  sizeBytes    Int
  folder       String @default("chat/attachments")

  // Link tracking: nếu file đã attach vào message thì lưu messageId.
  // Orphan = attachedAt=null sau 24h → cron xoá.
  attachedAt        DateTime?
  attachedMessageId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([attachedAt, createdAt]) // cho cron orphan cleanup
  @@index([attachedMessageId])
  @@map("upload_records")
}

// ─── Disputes ─────────────────────────────────────────────────────────────────

model Dispute {
  id         String  @id @default(uuid())
  bookingId  String
  propertyId String
  ownerId    String
  customerId String?
  // Người mở dispute
  openerType String // 'owner' | 'customer' | 'admin' | 'sale'
  openerId   String

  type        String // refund_request | service_quality | damage_claim | no_show | overbooking | other
  subject     String
  description String @db.Text
  amount      Int? // VND, optional — số tiền tranh chấp

  status       String  @default("pending") // pending | investigating | resolved | rejected
  resolution   String? @db.Text
  refundAmount Int? // VND — số tiền đồng ý hoàn (resolved only)

  resolvedById String?
  resolvedAt   DateTime?

  attachments Json? // ["url1", "url2"]
  penalty     String? // none | warning | refund | ban_temp | ban_perm — set when resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
  @@index([customerId])
  @@index([bookingId])
  @@map("disputes")
}

/// Admin call notes for chasing overdue subscription payments.
/// Created via POST /admin/subscriptions/:userId/call-log; listed in admin subscription detail.
model SubscriptionCallLog {
  id        String   @id @default(uuid())
  userId    String // OWNER user being chased
  adminId   String // admin who recorded the call
  note      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("subscription_call_logs")
}

// ─── Chat / Messaging ─────────────────────────────────────────────────────────

model Conversation {
  id         String  @id @default(uuid())
  // 'booking' (owner ↔ customer về 1 booking) | 'support' (user ↔ admin) | 'staff' (owner ↔ sale)
  type       String  @default("booking")
  bookingId  String?
  propertyId String? // denormalized for filter
  subject    String?

  // Denormalized for inbox listing — tránh JOIN messages khi list
  lastMessageAt      DateTime?
  lastMessagePreview String? // first ~120 chars
  lastSenderId       String?

  archivedAt DateTime?
  hasDispute Boolean   @default(false) // set khi có Dispute liên kết → bypass retention

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  // NOTE: Race condition khi 2 user mở chat cùng booking đồng thời được handle
  // ở app-level (createOrGet retry) — nếu cần DB-level guarantee, migrate thêm:
  //   @@unique([type, bookingId])
  @@index([type, lastMessageAt(sort: Desc)])
  @@index([bookingId])
  @@index([propertyId])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  role           String // 'owner' | 'sale' | 'customer' | 'admin'
  lastReadAt     DateTime?
  unreadCount    Int       @default(0)
  mutedUntil     DateTime?
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  attachments    Json? // [{ url, type, name, size }] tối đa 5
  isSystem       Boolean   @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([createdAt]) // for retention cron
  @@map("messages")
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id            String    @id @default(uuid())
  propertyId    String? // null nếu lead chung (chưa chọn cơ sở)
  ownerId       String? // resolve từ property hoặc do admin assign
  guestName     String
  guestPhone    String
  guestEmail    String?
  checkIn       DateTime?
  checkOut      DateTime?
  numGuests     Int?
  message       String?   @db.Text
  source        String? // 'public_form' | 'landing_page' | 'partner' | ...
  status        String    @default("new") // new | contacted | rejected | expired | converted
  assignedToId  String? // SALE đang xử lý
  contactedAt   DateTime?
  contactedById String?
  notes         String?   @db.Text // ghi chú nội bộ
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
  @@index([propertyId])
  @@map("leads")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorRole   Int // 0=ADMIN 1=OWNER 2=SALE 3=CUSTOMER
  action      String // 'user.ban' | 'property.approve' | 'subscription.markPaid' | ...
  targetType  String // 'user' | 'property' | 'booking' | 'dispute' | 'subscription' | 'review' | 'kyc'
  targetId    String?
  targetLabel String? // human-readable summary (name/email/code)
  metadata    Json? // arbitrary extra context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Support Tickets ──────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  code        String   @unique // HT-XXXXXX
  subject     String
  category    String // account | payment | technical | other
  description String   @db.Text
  status      String   @default("open") // open | in_progress | resolved | closed
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  fromAdmin   Boolean  @default(false)
  userId      String
  message     String   @db.Text
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model Feedback {
  id          String   @id @default(uuid())
  userId      String?
  category    String // bug | feature | support | other
  message     String   @db.Text
  contact     String?
  deviceInfo  String?
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("feedback")
}

// ─── Data Export (GDPR) ───────────────────────────────────────────────────────

model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("pending") // pending | processing | ready | expired
  downloadUrl String?
  expiresAt   DateTime?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@index([status])
  @@map("data_export_requests")
}

// ─── User Consent ─────────────────────────────────────────────────────────────

model UserConsent {
  id        String   @id @default(uuid())
  userId    String   @unique
  kyc       Boolean  @default(true)
  marketing Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

// ─── Notification Preferences ─────────────────────────────────────────────────

model NotificationPreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  booking    Boolean  @default(true)
  payment    Boolean  @default(true)
  system     Boolean  @default(true)
  quietHours Boolean  @default(false)
  quietFrom  String   @default("22:00")
  quietTo    String   @default("07:00")
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
