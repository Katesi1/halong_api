# ============================================================================
# Halong24h Backend — .env.example
# Đây là TEMPLATE — KHÔNG được commit secret thật vào file này.
# Copy sang .env và điền giá trị thật cho môi trường của bạn.
# ============================================================================

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homestay_db?schema=public"

# JWT — sinh secret bằng: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_RANDOM_32B_BASE64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_32B_BASE64"
JWT_REFRESH_EXPIRES_IN="14d"
# Secret RIÊNG cho reset-password token. KHÔNG dùng chung JWT_SECRET.
JWT_RESET_SECRET="REPLACE_WITH_RANDOM_32B_BASE64"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Cloudinary — lấy từ dashboard https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# App
PORT=3000
NODE_ENV="development"
# Production phải set danh sách domain được phép, ngăn cách bằng dấu phẩy.
ALLOWED_ORIGINS="https://halong24h.com,https://admin.halong24h.com"

# Giá web khách = giá gốc + markup% (chỉ giá phòng/đêm, không áp phụ thu). Sale/OWNER thấy giá gốc.
# Bỏ trống → mặc định 10. 0 = tắt markup (web khách = giá gốc).
PRICE_MARKUP_PERCENT=10

# Admin seed
ADMIN_PHONE="0900000000"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
ADMIN_NAME="Super Admin"

# Google Sign-In — Web Client ID (audience verify idToken từ mobile)
GOOGLE_OAUTH_WEB_CLIENT_ID=""

# Apple Sign-In — iOS Bundle ID (audience verify Apple idToken)
APPLE_CLIENT_ID=""

# Frontend base URL (cho staff invite link)
FRONTEND_BASE_URL="https://halong24h.com"

# App store download links (cho email mời nhân viên). Để trống → nút không hiển thị.
APP_STORE_URL="https://apps.apple.com/vn/app/halong24h/id6769460183?l=vi"
PLAY_STORE_URL=""

# Firebase service account JSON path (đặt file thật trong secrets/, đã gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/halong24h-firebase.json"

# SMTP — Gmail App Password (staff invite + password reset emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Halong24h <noreply@halong24h.com>"

# ============================================================================
# CITELY BLOG (nguồn bài blog ngoài — proxy + cache Redis phía server)
# READ-KEY chỉ để ở server, TUYỆT ĐỐI không lộ xuống app/browser.
# ============================================================================
CITELY_API_BASE="https://citely-seo.com/connect/v1/sites/0358604ac31d8e1a6d78ac076b9f47ff"
CITELY_READ_KEY=""
# TTL cache blog (giây). Mặc định 600 = 10 phút.
CITELY_CACHE_TTL=600

# ============================================================================
# PAYMENT (BẮT BUỘC ở production — service throw ngay khi boot nếu thiếu)
# ============================================================================

# VNPay sandbox/prod credentials (https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_API_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="https://halong24h.com/payments/vnpay/return"
VNPAY_IPN_URL=""

# Bank transfer info (VietQR)
BANK_NAME="Vietcombank"
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME=""
BANK_BIN=""

# BẮT BUỘC: secret dùng để verify webhook từ Casso / Sepay.
# Nếu thiếu, mọi webhook bank đều bị từ chối (chống fake thanh toán).
BANK_WEBHOOK_SECRET=""

# ============================================================================
# APPLE IN-APP PURCHASE (iOS only)
# Lấy từ App Store Connect → Users and Access → Integrations → In-App Purchase
# ============================================================================
APPLE_IAP_BUNDLE_ID="com.halongtravel.halong24h"
APPLE_IAP_KEY_ID=""                     # 10-char Key ID
APPLE_IAP_ISSUER_ID=""                  # UUID Issuer ID
# Chọn 1 trong 2: hoặc paste nội dung .p8 (escape \n) hoặc trỏ tới file path.
APPLE_IAP_PRIVATE_KEY=""                # "-----BEGIN PRIVATE KEY-----\n..."
APPLE_IAP_PRIVATE_KEY_PATH=""           # ./secrets/AuthKey_XXXXXXXXXX.p8
